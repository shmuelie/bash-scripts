#!/usr/bin/env bash
# git-worktree-switch — resolve a worktree and print its actual path.
# Ported from Set-Worktree.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { cat <<'EOF'
Usage: git-worktree-switch [-C <repository>] <branch>
       git-worktree-switch [-C <repository>] --path <worktree-path>
EOF
}

repo_arg=''; branch=''; target_path=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --path) target_path="$2"; shift 2 ;;
        -C|--repository-path) repo_arg="$2"; shift 2 ;;
        -*) die "Unknown option: $1" ;;
        *) [[ -z "$branch" ]] || die "Unexpected argument: $1"; branch="$1"; shift ;;
    esac
done
[[ -z "$branch" || -z "$target_path" ]] || die 'Specify either a branch or --path, not both.'
[[ -n "$branch" || -n "$target_path" ]] || { usage >&2; exit 2; }
require_cmd git
repo="$(git_resolve_repository_path "${repo_arg:-.}")" || exit 1
if [[ -n "$target_path" ]]; then row="$(git_resolve_worktree_target "$repo" path "$target_path")"
else row="$(git_resolve_worktree_target "$repo" branch "$branch")"; fi
path="${row%%"$SHM_FS"*}"
[[ -d "$path" ]] || die "Worktree path '$path' does not exist."
printf '%s\n' "$path"
