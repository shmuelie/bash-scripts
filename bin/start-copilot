#!/usr/bin/env bash
# start-copilot — launch the Copilot CLI with automatic session resume, default
# permissions, destructive-git deny rules, and MCP autoConnect policy.
# Ported from Start-Copilot. Delegates argument building to the shared
# launch-plan core so overlays can reuse identical command lines.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/copilot/copilot-common.sh"
source "$_SHM_ROOT/lib/copilot/launch-plan.sh"

# Pull out launcher-owned flags before delegating, without consuming a value
# that happens to have the same spelling or anything after `--`.
args=(); passthru=0; saw_ddash=0
while [[ $# -gt 0 ]]; do
    if [[ "$saw_ddash" == "1" ]]; then
        args+=("$1"); shift; continue
    fi
    case "$1" in
        --) args+=("$1"); saw_ddash=1; shift ;;
        --passthru) passthru=1; shift ;;
        --dry-run|--whatif) DRY_RUN=1; shift ;;
        --resume-session|--usage-output-file|--enable-mcp-server|--disable-mcp-server|--name|--session-id|--model|--reasoning-effort|--agent|--mode|--context|--add-dir|--log-level|--output-format|-C|--change-dir)
            args+=("$1")
            shift
            if [[ $# -gt 0 ]]; then args+=("$1"); shift; fi
            ;;
        *) args+=("$1"); shift ;;
    esac
done

[[ "${DRY_RUN:-0}" == "1" ]] && args+=(--defer-resume)
build_launch_plan "${args[@]+"${args[@]}"}" || exit $?

# --passthru: print the resolved plan (like Start-Copilot -PassThru) and stop.
if [[ "$passthru" == "1" ]]; then
    printf 'Exe: %s\n' "$COPILOT_EXE"
    printf 'Passthrough: %s\n' "$([[ "$COPILOT_PASSTHROUGH" == "1" ]] && echo true || echo false)"
    printf 'Args:'
    printf ' %q' "${COPILOT_ARGS[@]}"
    printf '\n'
    exit 0
fi

if ! should_process "Execute: $COPILOT_EXE ${COPILOT_ARGS[*]}"; then
    exit 0
fi

set +e
"$COPILOT_EXE" "${COPILOT_ARGS[@]}"
exit_code=$?
set -e

# Recover the terminal if the engine crashed out of its TUI.
if [[ "$exit_code" -ne 0 ]]; then
    if [[ -x "$_SHM_ROOT/bin/reset-terminal" ]]; then
        "$_SHM_ROOT/bin/reset-terminal" || true
    fi
fi

exit "$exit_code"
