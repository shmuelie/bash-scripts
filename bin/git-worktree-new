#!/usr/bin/env bash
# git-worktree-new — create a new branch checked out to a worktree.
# Ported from New-Worktree. Prints the new worktree path on success so callers
# can `cd "$(git-worktree-new ...)"`.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { cat <<'EOF'
Usage: git-worktree-new [options] <work-name>

Create a new branch with a conventional prefix and check it out to a worktree.
The branch path prints to stdout on success (use with cd).

Options:
  -k, --kind <user|feature|release>  Branch kind prefix (default: user).
  -u, --user <name>                  User segment for user branches.
  --no-prefix                        Use <work-name> verbatim as the branch.
  --dry-run, --whatif                Preview without creating.
  -v, --verbose                      Verbose output.
EOF
}

kind='user'; user=''; no_prefix=0; work_name=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -k|--kind) kind="$2"; shift 2 ;;
        -u|--user) user="$2"; shift 2 ;;
        --no-prefix) no_prefix=1; shift ;;
        --dry-run|--whatif) DRY_RUN=1; shift ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -*) die "Unknown option: $1" ;;
        *) work_name="$1"; shift ;;
    esac
done

[[ -n "$work_name" ]] || { usage >&2; die 'work-name is required.'; }
require_cmd git

if [[ "$no_prefix" == "1" ]]; then
    branch="$work_name"
else
    case "$kind" in
        user)
            bu="${user:-$(git_branch_user)}"
            branch="user/$bu/$work_name" ;;
        feature) branch="feature/$work_name" ;;
        release) branch="release/$work_name" ;;
        *) die "Invalid kind: $kind (expected user, feature, or release)" ;;
    esac
fi

worktree_path="$(git_worktree_path "$branch")" || die 'Not in a git repository.'

if ! should_process "Create worktree for new branch '$branch' at $worktree_path"; then
    exit 0
fi

git worktree add -b "$branch" "$worktree_path" >&2
printf '%s\n' "$worktree_path"
