#!/usr/bin/env bash
# git-worktree-root — show the root (main) worktree path.
# Ported from Get-RootWorktree.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { echo 'Usage: git-worktree-root [--path <repository-or-child>]'; }
repo_arg=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --path|-C) repo_arg="$2"; shift 2 ;;
        *) die "Unknown argument: $1" ;;
    esac
done
require_cmd git
repo="$(git_resolve_repository_path "${repo_arg:-.}")" || exit 1
line="$(git_root_worktree "$repo")" || exit 1
printf '%s\n' "${line%%"$SHM_FS"*}"
