#!/usr/bin/env bash
# copilot-session-maintenance — merge, compress, and repair Copilot sessions.
# Ported from SessionMaintenance.ps1. The event-stream algorithms live in
# lib/copilot/session-maintenance.js (Node); this wrapper resolves sessions and
# delegates. Requires Node (always present where the Copilot CLI runs).
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/copilot/copilot-common.sh"

HELPER="$_SHM_ROOT/lib/copilot/session-maintenance.js"

usage() { cat <<'EOF'
Usage: copilot-session-maintenance <command> [args]

Commands:
  repair-events <id> [--no-backup] [--dry-run]
      Sanitize a session's events.jsonl (relocate orphaned tool events, strip
      error/malformed events, synthesize missing tool completions).

  compress <id> [--keep N] [--no-backup] [--dry-run]
      Keep only the last N user/assistant exchanges (default 5) to shrink an
      oversized session.

  merge <id1> <id2> [idN...] [--remove-source] [--dry-run]
      Merge two or more sessions (same directory) into a new resumable session.
EOF
}

session_path() {
    copilot_resolve_session_dir "$1"
}

cmd="${1:-}"; shift || true
case "$cmd" in
    -h|--help|'') usage; [[ -n "$cmd" ]] && exit 0 || exit 2 ;;
esac
# Show usage for `<subcommand> --help` too (but not past a `--` passthrough).
for _a in "$@"; do [[ "$_a" == "--" ]] && break; case "$_a" in -h|--help) usage; exit 0 ;; esac; done
require_cmd node

case "$cmd" in
    repair-events)
        id=''; nobackup=()
        for a in "$@"; do
            case "$a" in
                --no-backup) nobackup=(--no-backup) ;;
                --dry-run|--whatif) DRY_RUN=1 ;;
                *) id="$a" ;;
            esac
        done
        [[ -n "$id" ]] || die 'repair-events requires a session id.'
        session_path "$id" >/dev/null || exit 1
        should_process "Repair events for session ${id:0:8}" || exit 0
        dir="$(session_path "$id")" ||
            die "Session '$id' changed before it could be repaired."
        node "$HELPER" repair-events "$dir" "${nobackup[@]}"
        ;;
    compress)
        id=''; keep=(); nobackup=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --keep)
                    [[ $# -ge 2 ]] || die '--keep requires a positive integer.'
                    [[ "$2" =~ ^[1-9][0-9]*$ ]] || die '--keep requires a positive integer.'
                    keep=(--keep "$2"); shift 2 ;;
                --no-backup) nobackup=(--no-backup); shift ;;
                --dry-run|--whatif) DRY_RUN=1; shift ;;
                *) id="$1"; shift ;;
            esac
        done
        [[ -n "$id" ]] || die 'compress requires a session id.'
        session_path "$id" >/dev/null || exit 1
        should_process "Compress session ${id:0:8}" || exit 0
        dir="$(session_path "$id")" ||
            die "Session '$id' changed before it could be compressed."
        node "$HELPER" compress "$dir" "${keep[@]}" "${nobackup[@]}"
        ;;
    merge)
        ids=(); remove_source=0
        for a in "$@"; do
            case "$a" in
                --remove-source) remove_source=1 ;;
                --dry-run|--whatif) DRY_RUN=1 ;;
                *) ids+=("$a") ;;
            esac
        done
        [[ ${#ids[@]} -ge 2 ]] || die 'merge requires at least two session ids.'
        dirs=()
        for id in "${ids[@]}"; do
            d="$(session_path "$id")" || exit 1
            dirs+=("$d")
        done
        state_dir="$(copilot_session_state_dir)"
        state_dir="$(cd -- "$state_dir" && pwd -P)"
        new_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)"
        new_dir="$state_dir/$new_id"
        if ! should_process "Merge ${#ids[@]} sessions into $new_id"; then exit 0; fi

        dirs=()
        for id in "${ids[@]}"; do
            d="$(session_path "$id")" ||
                die "Session '$id' changed before it could be merged."
            dirs+=("$d")
        done
        set +e
        result_id="$(node "$HELPER" merge "$new_dir" "${dirs[@]}")"
        merge_status=$?
        set -e
        if [[ "$merge_status" -ne 0 ]]; then
            if [[ -e "$new_dir" || -L "$new_dir" ]]; then
                if ! rm -rf -- "$new_dir"; then
                    log_error "Failed to remove partial merged session: $new_dir"
                fi
            fi
            die "$merge_status" 'Merge failed.'
        fi
        [[ "$result_id" == "$new_id" ]] || {
            rm -rf -- "$new_dir" ||
                log_error "Failed to remove invalid merged session: $new_dir"
            die 'Merge returned an unexpected session id.'
        }
        if [[ "$remove_source" == "1" ]]; then
            current_dirs=()
            for i in "${!ids[@]}"; do
                d="$(session_path "${ids[$i]}")" ||
                    die "Source session '${ids[$i]}' changed before removal."
                [[ "$d" == "${dirs[$i]}" ]] ||
                    die "Source session '${ids[$i]}' changed before removal."
                current_dirs+=("$d")
            done
            for d in "${current_dirs[@]}"; do
                log_verbose "Removing source session: $d"
                rm -rf -- "$d"
            done
        fi
        printf '%s\n' "$result_id"
        ;;
    *) die "Unknown command: $cmd (see --help)" ;;
esac
