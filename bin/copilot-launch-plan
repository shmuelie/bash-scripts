#!/usr/bin/env bash
# copilot-launch-plan — resolve and print the Copilot CLI launch plan without
# launching. Ported from Get-CopilotLaunchPlan. Mirrors Start-Copilot -PassThru.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/copilot/copilot-common.sh"
source "$_SHM_ROOT/lib/copilot/launch-plan.sh"

# Extract our --json before delegating, preserving adjacent option values and
# all arguments after `--`.
args=(); want_json=0; saw_ddash=0
while [[ $# -gt 0 ]]; do
    if [[ "$saw_ddash" == "1" ]]; then
        args+=("$1"); shift; continue
    fi
    case "$1" in
        --) args+=("$1"); saw_ddash=1; shift ;;
        --json) want_json=1; shift ;;
        --resume-session|--usage-output-file|--enable-mcp-server|--disable-mcp-server|--name|--session-id|--model|--reasoning-effort|--agent|--mode|--context|--add-dir|--log-level|--output-format|-C|--change-dir)
            args+=("$1")
            shift
            if [[ $# -gt 0 ]]; then args+=("$1"); shift; fi
            ;;
        *) args+=("$1"); shift ;;
    esac
done

build_launch_plan "${args[@]}" || exit $?

if [[ "$want_json" == "1" ]]; then
    require_cmd jq
    printf '%s\n' "${COPILOT_ARGS[@]}" | jq -R -s \
        --arg exe "$COPILOT_EXE" \
        --argjson passthrough "$([[ "$COPILOT_PASSTHROUGH" == "1" ]] && echo true || echo false)" \
        '{exe:$exe, passthrough:$passthrough,
          args: (split("\n") | map(select(length>0)))}'
else
    printf 'Exe: %s\n' "$COPILOT_EXE"
    printf 'Passthrough: %s\n' "$([[ "$COPILOT_PASSTHROUGH" == "1" ]] && echo true || echo false)"
    printf 'Args:'
    printf ' %q' "${COPILOT_ARGS[@]}"
    printf '\n'
fi
