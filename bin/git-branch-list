#!/usr/bin/env bash
# git-branch-list — structured branches; ported from Shmuelie.Git Get-Branch.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"
source "$_SHM_ROOT/lib/git/git-ports.sh"
source "$_SHM_ROOT/lib/git/git-ref-info.sh"
git_branch_list "$@"
