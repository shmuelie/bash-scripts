#!/usr/bin/env bash
# dotnet-sdk-install -- Install-DotNetSdk from Shmuelie.DotNet/SdkHelpers.ps1.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/utils/dotnet-sdk.sh"
shm_install_dotnet_sdk "$@"
