#!/usr/bin/env bash
# git-worktree-update — fast-forward every worktree from upstream.
# Ported from Update-Worktrees.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { cat <<'EOF'
Usage: git-worktree-update [options]

Statuses: Current, Updated, Skipped, NoUpstream, Removed, InProgress,
Missing, Failed, StashFailed.

Options:
  --path, -C <repository-or-child>  Repository to update.
  --check-remote                    Reclassify missing NoUpstream branches.
  --github-account <host/owner=account>
                                    Forward account mapping (repeatable).
  --no-github-account-resolve       Disable account-aware fetch.
  --json                            Emit JSON.
  --dry-run, --whatif               Preview without merging.
  -v, --verbose                     Verbose output.
EOF
}

check_remote=0; repo_arg=''; no_account_resolve=0; github_accounts=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --path|-C) repo_arg="$2"; shift 2 ;;
        --check-remote) check_remote=1; shift ;;
        --github-account) github_accounts+=("$2"); shift 2 ;;
        --no-github-account-resolve) no_account_resolve=1; shift ;;
        --json) JSON=1; shift ;;
        --dry-run|--whatif) DRY_RUN=1; shift ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -*) die "Unknown option: $1" ;;
        *) die "Unexpected argument: $1" ;;
    esac
done

require_cmd git
require_cmd jq
repo="$(git_resolve_repository_path "${repo_arg:-.}")" || exit 1

sync_args=(--path "$repo" --json)
[[ "$DRY_RUN" == "1" ]] && sync_args+=(--dry-run)
[[ "$VERBOSE" == "1" ]] && sync_args+=(--verbose)
[[ "$no_account_resolve" == "1" ]] && sync_args+=(--no-github-account-resolve)
for mapping in "${github_accounts[@]}"; do sync_args+=(--github-account "$mapping"); done

declare -A pruned=()
fetch_json='[]'
if [[ "$DRY_RUN" == "1" ]]; then
    "$_SHM_ROOT/bin/git-sync" "${sync_args[@]}" >/dev/null
else
    fetch_json="$("$_SHM_ROOT/bin/git-sync" "${sync_args[@]}")" ||
        die 'Failed to fetch remotes.'
fi
while IFS="$SHM_FS" read -r action ref _; do
    if [[ "$action" == 'Deleted' && "$ref" =~ ^[^/]+/(.+)$ ]]; then
        pruned["${BASH_REMATCH[1]}"]=1
    fi
done < <(printf '%s' "$fetch_json" | jq -r --arg fs "$SHM_FS" '.[] | [.action,.ref,.summary]|join($fs)')

declare -A b_ahead=() b_behind=() b_gone=() b_hasup=()
while IFS='|' read -r branch upstream track; do
    [[ -n "$branch" ]] || continue
    ahead=0; behind=0; gone=0
    if [[ "$track" == *'[gone]'* ]]; then
        gone=1
    else
        [[ "$track" =~ ahead\ ([0-9]+) ]] && ahead="${BASH_REMATCH[1]}"
        [[ "$track" =~ behind\ ([0-9]+) ]] && behind="${BASH_REMATCH[1]}"
    fi
    b_ahead["$branch"]="$ahead"; b_behind["$branch"]="$behind"; b_gone["$branch"]="$gone"
    [[ -n "$upstream" ]] && b_hasup["$branch"]=1 || b_hasup["$branch"]=0
done < <(git -C "$repo" for-each-ref --format='%(refname:short)|%(upstream:short)|%(upstream:track)' refs/heads/)

results=()
behind_list=()
while IFS="$SHM_FS" read -r wt_path _ branch _bare detached _locked _lock_reason _prunable _prunable_reason; do
    if [[ -z "$branch" || "$detached" == "1" ]]; then
        results+=("$branch$SHM_FS$wt_path${SHM_FS}NoUpstream${SHM_FS}0$SHM_FS$SHM_FS"0)
        continue
    fi
    hasup="${b_hasup[$branch]:-0}"; gone="${b_gone[$branch]:-0}"
    ahead="${b_ahead[$branch]:-0}"; behind="${b_behind[$branch]:-0}"
    if [[ "$hasup" == "0" ]]; then
        if [[ -n "${pruned[$branch]:-}" ]]; then status='Removed'; else status='NoUpstream'; fi
        results+=("$branch$SHM_FS$wt_path$SHM_FS$status${SHM_FS}0$SHM_FS$SHM_FS"0)
    elif [[ "$gone" == "1" ]]; then
        results+=("$branch$SHM_FS$wt_path${SHM_FS}Removed${SHM_FS}0$SHM_FS$SHM_FS"0)
    elif [[ "$ahead" -gt 0 ]]; then
        results+=("$branch$SHM_FS$wt_path${SHM_FS}Skipped$SHM_FS$behind$SHM_FS$SHM_FS"0)
    elif [[ "$behind" -eq 0 ]]; then
        results+=("$branch$SHM_FS$wt_path${SHM_FS}Current${SHM_FS}0$SHM_FS$SHM_FS"0)
    else
        operation="$(git_operation "$wt_path")"
        if [[ -n "$operation" ]]; then
            results+=("$branch$SHM_FS$wt_path${SHM_FS}InProgress$SHM_FS$behind$SHM_FS$operation${SHM_FS}0")
        else
            behind_list+=("$branch$SHM_FS$wt_path$SHM_FS$behind")
        fi
    fi
done < <(git_worktrees "$repo")

if [[ "$check_remote" == "1" ]]; then
    declare -A remote_refs=()
    if remote_output="$(git -C "$repo" --no-pager ls-remote --heads origin 2>&1)"; then
        while IFS= read -r ref_line; do
            ref_branch="${ref_line#*$'\t'refs/heads/}"
            [[ "$ref_branch" != "$ref_line" ]] && remote_refs["$ref_branch"]=1
        done <<< "$remote_output"
        new_results=()
        for row in "${results[@]}"; do
            IFS="$SHM_FS" read -r br wt_path st bh op stashed <<< "$row"
            if [[ "$st" == 'NoUpstream' && -n "$br" && -z "${remote_refs[$br]:-}" ]]; then st='Removed'; fi
            new_results+=("$br$SHM_FS$wt_path$SHM_FS$st$SHM_FS$bh$SHM_FS$op$SHM_FS$stashed")
        done
        results=("${new_results[@]}")
    else
        log_warn "Skipping remote branch check: git ls-remote failed for 'origin': $remote_output. NoUpstream worktrees left unclassified."
    fi
fi

if [[ ${#behind_list[@]} -gt 0 ]] &&
    should_process "Fast-forward ${#behind_list[@]} worktrees from upstream"; then
    for entry in "${behind_list[@]}"; do
        IFS="$SHM_FS" read -r branch wt_path behind <<< "$entry"
        if [[ ! -d "$wt_path" ]]; then
            results+=("$branch$SHM_FS$wt_path${SHM_FS}Missing$SHM_FS$behind$SHM_FS$SHM_FS"0)
            continue
        fi
        stashed=0
        dirty="$(git -C "$wt_path" status --porcelain 2>/dev/null || true)"
        if [[ -n "$dirty" ]]; then
            if git -C "$wt_path" stash push --include-untracked --quiet >/dev/null 2>&1; then
                stashed=1
            else
                results+=("$branch$SHM_FS$wt_path${SHM_FS}StashFailed$SHM_FS$behind$SHM_FS$SHM_FS"0)
                continue
            fi
        fi
        if git -C "$wt_path" merge --ff-only '@{upstream}' --quiet >/dev/null 2>&1; then
            status='Updated'
        else
            status='Failed'
        fi
        if [[ "$stashed" == "1" ]] &&
            ! git -C "$wt_path" stash pop --quiet >/dev/null 2>&1; then
            log_warn "git stash pop failed for $branch"
        fi
        results+=("$branch$SHM_FS$wt_path$SHM_FS$status$SHM_FS$behind$SHM_FS$SHM_FS$stashed")
    done
fi

if [[ "$JSON" == "1" ]]; then
    if [[ ${#results[@]} -eq 0 ]]; then echo '[]'; else
        printf '%s\n' "${results[@]}" | jq -R -s --arg fs "$SHM_FS" '
            def nz: if .=="" then null else . end;
            split("\n") | map(select(length>0) | split($fs) |
            {branch:(.[0]|nz), path:.[1], status:.[2],
             behindBy:(.[3]|tonumber), operation:(.[4]|nz), stashed:(.[5]=="1")})'
    fi
else
    printf '%-32s %-12s %-7s %-42s %s\n' 'BRANCH' 'STATUS' 'BEHIND' 'PATH' 'OPERATION'
    for row in "${results[@]}"; do
        IFS="$SHM_FS" read -r br wt_path st bh op _ <<< "$row"
        printf '%-32s %-12s %-7s %-42s %s\n' "$br" "$st" "$bh" "$wt_path" "$op"
    done
fi

update_failed=0
for row in "${results[@]}"; do
    IFS="$SHM_FS" read -r _ _ st _ <<< "$row"
    case "$st" in
        Failed|StashFailed|Missing) update_failed=1 ;;
    esac
done
exit "$update_failed"
