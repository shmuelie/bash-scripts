#!/usr/bin/env bash
# git-worktree-current — show the worktree containing the current directory.
# Ported from Get-CurrentWorktree.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

case "${1:-}" in
    -h|--help) echo 'Usage: git-worktree-current'; exit 0 ;;
esac

require_cmd git
line="$(git_current_worktree)"
[[ -n "$line" ]] || exit 1
printf '%s\n' "$(printf '%s' "$line" | cut -f1)"
