#!/usr/bin/env bash
# git-worktree-current — show the worktree containing a repository path.
# Ported from Get-CurrentWorktree.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { echo 'Usage: git-worktree-current [--path <repository-or-child>]'; }
repo_arg=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --path|-C) repo_arg="$2"; shift 2 ;;
        *) die "Unknown argument: $1" ;;
    esac
done
require_cmd git
candidate="${repo_arg:-.}"
repo="$(git_resolve_repository_path "$candidate")" || exit 1
line="$(git_current_worktree "$repo" "$candidate")" || exit 1
printf '%s\n' "${line%%"$SHM_FS"*}"
