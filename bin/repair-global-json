#!/usr/bin/env bash
# repair-global-json — set sdk.rollForward to "disable" in ./global.json.
# Ported from Repair-GlobalJson.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
require_cmd jq
for a in "$@"; do
    case "$a" in
        --dry-run|--whatif) DRY_RUN=1 ;;
        -h|--help) echo 'Usage: repair-global-json [--dry-run]'; exit 0 ;;
        *) die "Unknown option: $a" ;;
    esac
done
[[ -f global.json ]] || die 'No global.json in the current directory.'
should_process "Set sdk.rollForward to 'disable' in ./global.json" || exit 0
tmp="$(mktemp)"
jq '.sdk.rollForward = "disable"' global.json > "$tmp"
mv "$tmp" global.json
