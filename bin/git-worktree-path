#!/usr/bin/env bash
# git-worktree-path — compute the conventional path for a branch worktree.
# Ported from Get-WorktreePath.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/git/git-common.sh"

usage() { echo 'Usage: git-worktree-path [--path <repository-or-child>] <branch>'; }
repo_arg=''; branch=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --path|-C) repo_arg="$2"; shift 2 ;;
        -*) die "Unknown option: $1" ;;
        *) [[ -z "$branch" ]] || die "Unexpected argument: $1"; branch="$1"; shift ;;
    esac
done
[[ -n "$branch" ]] || { usage >&2; exit 2; }
require_cmd git
repo="$(git_resolve_repository_path "${repo_arg:-.}")" || exit 1
git_worktree_path "$repo" "$branch"
