#!/usr/bin/env bash
# copilot-plugin — manage Copilot CLI plugins. Ported from Plugins.ps1.
# Subcommands: list, install, update, uninstall.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/copilot/copilot-common.sh"

usage() { cat <<'EOF'
Usage: copilot-plugin <command> [args]

Commands:
  list [pattern] [--json]     List installed plugins (optional glob filter).
  install <source> [--dry-run] Install a plugin (owner/repo, plugin@marketplace, URL).
  update <name> [--dry-run]   Update a plugin (retries once on EBUSY).
  uninstall <name> [--dry-run] Uninstall a plugin by full name.
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
    -h|--help|'') usage; [[ -n "$cmd" ]] && exit 0 || exit 2 ;;
esac
# Show usage for `<subcommand> --help` too (but not past a `--` passthrough).
for _a in "$@"; do [[ "$_a" == "--" ]] && break; case "$_a" in -h|--help) usage; exit 0 ;; esac; done
require_cmd copilot

case "$cmd" in
    list)
        pattern='*'; json=0
        for a in "$@"; do
            case "$a" in
                --json) json=1 ;;
                *) pattern="$a" ;;
            esac
        done
        inventory="$(copilot_plugins_json)" || exit $?
        rows_text="$(jq -r '.[] | [.name,.fullName] | join("\u001f")' <<< "$inventory")"
        mapfile -t rows <<< "$rows_text"
        # Filter by name or fullname glob.
        filtered=()
        for row in "${rows[@]:-}"; do
            [[ -z "$row" ]] && continue
            IFS="$SHM_FS" read -r name full <<< "$row"
            [[ -z "$name" ]] && continue
            # shellcheck disable=SC2053
            if [[ "$name" == $pattern || "$full" == $pattern ]]; then
                filtered+=("$full")
            fi
        done
        matches="$(printf '%s\n' "${filtered[@]}" | jq -Rsc 'split("\n") | map(select(length>0))')"
        result="$(jq --argjson matches "$matches" '[.[] | select(.fullName as $n | $matches | index($n))]' <<< "$inventory")"
        if [[ "$json" == "1" ]]; then
            printf '%s\n' "$result"
        else
            jq -r '.[] | "\(.fullName) v\(.version) [\(if .enabled then "enabled" else "disabled" end)] (\(.source))"' <<< "$result"
        fi
        ;;
    install)
        source_arg="${1:-}"; [[ -n "$source_arg" ]] || die 'install requires a source.'
        [[ "${2:-}" != "--dry-run" && "${2:-}" != "--whatif" ]] || DRY_RUN=1
        exe="$(resolve_copilot)"
        should_process "copilot plugin install $source_arg" || exit 0
        inventory="$(copilot_plugins_json)" || exit $?
        if copilot_plugin_install_match "$inventory" "$source_arg"; then
            log_verbose "Plugin from '$source_arg' is already installed."
            exit 0
        else
            match_status=$?
            [[ "$match_status" == "1" ]] || exit "$match_status"
        fi
        "$exe" plugin install "$source_arg" || die "Failed to install plugin: $source_arg"
        ;;
    update)
        name="${1:-}"; [[ "$name" == "--dry-run" || "$name" == "--whatif" ]] && { DRY_RUN=1; name="${2:-}"; }
        [[ -n "$name" ]] || die 'update requires a plugin name.'
        [[ "${2:-}" == "--dry-run" || "${2:-}" == "--whatif" ]] && DRY_RUN=1
        exe="$(resolve_copilot)"
        should_process "copilot plugin update $name" || exit 0
        if ! out="$("$exe" plugin update "$name" 2>&1)"; then
            if [[ "$out" == *EBUSY* ]]; then
                log_verbose "EBUSY detected for $name — retrying in 2 seconds..."
                sleep 2
                if ! out="$("$exe" plugin update "$name" 2>&1)"; then
                    log_warn "Failed to update $name — directory locked by running sessions. Close other sessions and retry."
                    printf '%s\n' "$out" >&2
                    exit 1
                fi
            else
                log_warn "Failed to update plugin: $name — $out"
                exit 1
            fi
        fi
        printf '%s\n' "$out"
        ;;
    uninstall)
        name="${1:-}"; [[ "$name" == "--dry-run" || "$name" == "--whatif" ]] && { DRY_RUN=1; name="${2:-}"; }
        [[ -n "$name" ]] || die 'uninstall requires a plugin name.'
        exe="$(resolve_copilot)"
        should_process "copilot plugin uninstall $name" || exit 0
        "$exe" plugin uninstall "$name" || die "Failed to uninstall plugin: $name"
        ;;
    *) die "Unknown command: $cmd (see --help)" ;;
esac
