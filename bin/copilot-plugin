#!/usr/bin/env bash
# copilot-plugin — manage Copilot CLI plugins. Ported from Plugins.ps1.
# Subcommands: list, install, update, uninstall.
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/copilot/copilot-common.sh"

usage() { cat <<'EOF'
Usage: copilot-plugin <command> [args]

Commands:
  list [pattern] [--json]     List installed plugins (optional glob filter).
  install <source>            Install a plugin (owner/repo, plugin@marketplace, URL).
  update <name> [--dry-run]   Update a plugin (retries once on EBUSY).
  uninstall <name> [--dry-run] Uninstall a plugin by full name.
EOF
}

# parse_plugin_list — read `copilot plugin list` and emit "name<TAB>fullname<TAB>marketplace<TAB>version".
parse_plugin_list() {
    local exe; exe="$(resolve_copilot)"
    "$exe" plugin list 2>&1 | while IFS= read -r line; do
        if [[ "$line" =~ ^[[:space:]]+•[[:space:]]+(.+)[[:space:]]+\(v(.+)\)[[:space:]]*$ ]]; then
            local full="${BASH_REMATCH[1]}" version="${BASH_REMATCH[2]}"
            full="${full%"${full##*[![:space:]]}"}"   # rtrim
            local name="$full" marketplace=''
            if [[ "$full" =~ ^(.+)@(.+)$ ]]; then
                name="${BASH_REMATCH[1]}"; marketplace="${BASH_REMATCH[2]}"
            fi
            printf '%s%s%s%s%s%s%s\n' "$name" "$SHM_FS" "$full" "$SHM_FS" "$marketplace" "$SHM_FS" "$version"
        fi
    done
}

cmd="${1:-}"; shift || true
case "$cmd" in
    -h|--help|'') usage; [[ -n "$cmd" ]] && exit 0 || exit 2 ;;
esac
# Show usage for `<subcommand> --help` too (but not past a `--` passthrough).
for _a in "$@"; do [[ "$_a" == "--" ]] && break; case "$_a" in -h|--help) usage; exit 0 ;; esac; done
require_cmd copilot

case "$cmd" in
    list)
        pattern='*'; json=0
        for a in "$@"; do
            case "$a" in
                --json) json=1 ;;
                *) pattern="$a" ;;
            esac
        done
        mapfile -t rows < <(parse_plugin_list)
        # Filter by name or fullname glob.
        filtered=()
        for row in "${rows[@]:-}"; do
            [[ -z "$row" ]] && continue
            IFS="$SHM_FS" read -r name full marketplace version <<< "$row"
            [[ -z "$name" ]] && continue
            # shellcheck disable=SC2053
            if [[ "$name" == $pattern || "$full" == $pattern ]]; then
                filtered+=("$name$SHM_FS$full$SHM_FS$marketplace$SHM_FS$version")
            fi
        done
        if [[ "$json" == "1" ]]; then
            require_cmd jq
            if [[ ${#filtered[@]} -eq 0 ]]; then echo '[]'; else
                printf '%s\n' "${filtered[@]}" | jq -R -s 'def nz: if .=="" then null else . end;
                    split("\n") | map(select(length>0) | split("\u001f") |
                    {name:.[0], fullName:.[1], marketplace:(.[2]|nz), version:.[3]})'
            fi
        else
            for r in "${filtered[@]:-}"; do
                [[ -z "$r" ]] && continue
                # shellcheck disable=SC2034  # unpacking a fixed row; only some fields printed
                IFS="$SHM_FS" read -r name full marketplace version <<< "$r"
                printf '%-40s v%s\n' "$full" "$version"
            done
        fi
        ;;
    install)
        source_arg="${1:-}"; [[ -n "$source_arg" ]] || die 'install requires a source.'
        exe="$(resolve_copilot)"
        # Skip if already installed (check name or full name column).
        check="$source_arg"
        if [[ "$source_arg" =~ ^(.+)@ ]]; then check="${BASH_REMATCH[1]}"
        elif [[ "$source_arg" =~ /([^/#]+)(#|$) ]]; then check="${BASH_REMATCH[1]}"; fi
        while IFS="$SHM_FS" read -r p_name p_full _; do
            if [[ "$p_name" == "$check" || "$p_full" == "$source_arg" ]]; then
                log_verbose "Plugin '$p_full' appears to be installed."
            fi
        done < <(parse_plugin_list)
        "$exe" plugin install "$source_arg" || die "Failed to install plugin: $source_arg"
        ;;
    update)
        name="${1:-}"; [[ "$name" == "--dry-run" || "$name" == "--whatif" ]] && { DRY_RUN=1; name="${2:-}"; }
        [[ -n "$name" ]] || die 'update requires a plugin name.'
        [[ "${2:-}" == "--dry-run" || "${2:-}" == "--whatif" ]] && DRY_RUN=1
        exe="$(resolve_copilot)"
        should_process "copilot plugin update $name" || exit 0
        if ! out="$("$exe" plugin update "$name" 2>&1)"; then
            if [[ "$out" == *EBUSY* ]]; then
                log_verbose "EBUSY detected for $name — retrying in 2 seconds..."
                sleep 2
                if ! out="$("$exe" plugin update "$name" 2>&1)"; then
                    log_warn "Failed to update $name — directory locked by running sessions. Close other sessions and retry."
                    printf '%s\n' "$out" >&2
                    exit 1
                fi
            else
                log_warn "Failed to update plugin: $name — $out"
                exit 1
            fi
        fi
        printf '%s\n' "$out"
        ;;
    uninstall)
        name="${1:-}"; [[ "$name" == "--dry-run" || "$name" == "--whatif" ]] && { DRY_RUN=1; name="${2:-}"; }
        [[ -n "$name" ]] || die 'uninstall requires a plugin name.'
        exe="$(resolve_copilot)"
        should_process "copilot plugin uninstall $name" || exit 0
        "$exe" plugin uninstall "$name" || die "Failed to uninstall plugin: $name"
        ;;
    *) die "Unknown command: $cmd (see --help)" ;;
esac
