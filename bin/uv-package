#!/usr/bin/env bash
# uv-package — list and update uv packages in the system environment.
# Ported from UvHelpers.ps1 (Get-UvPackages / Update-UvPackage).
set -euo pipefail
_SHM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$_SHM_ROOT/lib/common.sh"
source "$_SHM_ROOT/lib/utils/json-output.sh"
source "$_SHM_ROOT/lib/utils/package-validation.sh"

usage() { cat <<'EOF'
Usage: uv-package <command> [options]

Commands:
  list [--outdated] [--top-level] [--json]
      List packages (uv pip list --system). --top-level keeps only packages
      with no Required-by entry.
  update <name> [--dry-run]
      Upgrade a package (uv pip install --upgrade --system). Reads stdin too.
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
    -h|--help|'') usage; [[ -n "$cmd" ]] && exit 0 || exit 2 ;;
esac
# Show usage for `<subcommand> --help` too (but not past a `--` passthrough).
for _a in "$@"; do [[ "$_a" == "--" ]] && break; case "$_a" in -h|--help) usage; exit 0 ;; esac; done
require_cmd uv

case "$cmd" in
    list)
        outdated=0; top=0; json=0
        for a in "$@"; do
            case "$a" in
                --outdated) outdated=1 ;;
                --top-level) top=1 ;;
                --json) json=1 ;;
                *) die "Unknown option: $a" ;;
            esac
        done
        args=(pip list --no-progress --format json --system)
        [[ "$outdated" == "1" ]] && args+=(--outdated)
        require_cmd jq
        raw="$(uv "${args[@]}")"
        out="$(printf '%s' "$raw" | extract_json_payload)" ||
            die 'No valid JSON payload found in uv output.'
        package_validate_inventory <<< "$out"
        if [[ "$top" == "1" ]]; then
            # Keep only packages with an empty Required-by field.
            filtered='[]'
            while IFS= read -r pkg; do
                [[ -z "$pkg" ]] && continue
                package_validate_python "$pkg"
                details="$(uv pip show "$pkg" --system)"
                grep -q '^Required-by:' <<< "$details" || die "Missing Required-by field for $pkg."
                if ! grep -qE '^Required-by:[[:space:]]+\S' <<< "$details"; then
                    filtered="$(printf '%s' "$filtered" | jq --arg p "$pkg" '. + [$p]')"
                fi
            done < <(printf '%s' "$out" | jq -r '.[].name')
            out="$(printf '%s' "$out" | jq --argjson keep "$filtered" 'map(select(.name as $n | $keep | index($n)))')"
        fi
        if [[ "$json" == "1" ]]; then
            printf '%s\n' "$out"
        else
            printf '%s' "$out" | jq -r '.[] | "\(.name)\t\(.version)\(if .latest_version then "\t-> "+.latest_version else "" end)"'
        fi
        ;;
    update)
        name=''
        for a in "$@"; do
            case "$a" in
                --dry-run|--whatif) DRY_RUN=1 ;;
                *) [[ -z "$name" ]] || die 'update accepts one name (or piped names).'; name="$a" ;;
            esac
        done
        do_update() {
            local n="$1" result=0
            package_validate_python "$n" || return 1
            should_process "uv pip install --upgrade $n --system" || return 0
            uv pip install --upgrade "$n" --system || result=$?
            [[ "$result" == 0 ]] || log_warn "Failed to update: $n (exit $result)"
            return "$result"
        }
        if [[ -n "$name" ]]; then do_update "$name"
        elif [[ ! -t 0 ]]; then while IFS= read -r l || [[ -n "$l" ]]; do do_update "$l"; done
        else die 'update requires a package name (or piped names).'; fi
        ;;
    *) die "Unknown command: $cmd (see --help)" ;;
esac
